# Postgres connection string. For local dev, run `npx prisma dev` and paste
# the connection string it prints. For production, use your Neon/Vercel
# Postgres connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Your deployed URL, used to build the shareable tournament link shown on the
# admin dashboard. Optional — the app falls back to a relative link without it.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
